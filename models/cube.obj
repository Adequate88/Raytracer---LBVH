# Simple cube mesh
# 8 vertices, 6 faces (12 triangles)

# Vertices
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1

# Vertex normals
vn  0  0 -1
vn  0  0  1
vn -1  0  0
vn  1  0  0
vn  0 -1  0
vn  0  1  0

# Front face (z = -1)
f 1//1 2//1 3//1
f 1//1 3//1 4//1

# Back face (z = 1)
f 5//2 6//2 7//2
f 5//2 7//2 8//2

# Left face (x = -1)
f 1//3 5//3 8//3
f 1//3 8//3 4//3

# Right face (x = 1)
f 2//4 6//4 7//4
f 2//4 7//4 3//4

# Bottom face (y = -1)
f 1//5 5//5 6//5
f 1//5 6//5 2//5

# Top face (y = 1)
f 4//6 8//6 7//6
f 4//6 7//6 3//6
