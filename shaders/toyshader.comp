#version 460
#extension GL_GOOGLE_include_directive : require
#include "triangle.glsl"

const float PI = 3.14159;
const int MAX_BOUNCES = 2;
const int SAMPLES = 1;

// From: https://stackoverflow.com/questions/9912143/how-to-get-a-random-number-in-opencl
//noise values in range if 0.0 to 1.0
float noise3D(float x, float y, float z) {
  return fract(sin(x * 112.9898f + y * 179.233f + z * 237.212f) * 43758.5453f);
}

layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform Camera {
  vec4 center;
  vec4 pixel00_loc;
  vec4 pixel_delta_u;
  vec4 pixel_delta_v;
} cam;
layout(binding = 1, std430) readonly buffer SceneBuffer {
  triangle triangles[];
} scene;

layout(binding = 0, rgba8) uniform writeonly image2D img;

void main() {
  ivec2 thread = ivec2(gl_GlobalInvocationID.xy);
  ivec2 imgSize = imageSize(img);

  if (thread.x < imgSize.x && thread.y < imgSize.y) {
    // calculate pixel position in world

    vec3 energy = vec3(0.0, 0.0, 0.0);
    vec3 BRDF = vec3(0.4, 0.6, 0.4); // / PI;
    float hemiPDF = 1.0 / (PI * 2.0f);

    vec3 background_color = vec3(0.7, 0.8, 1.0);
    vec3 light_dir = normalize(vec3(1.0, 2.0, 3.0));

    for (int s = 0; s < SAMPLES; s++) {
      float seed = noise3D(float(thread.x), float(thread.y), float(s));
      float jx = noise3D(float(thread.x), float(thread.y), float(s) + 0.5) - 0.5;
      float jy = noise3D(float(thread.x), float(thread.y), float(s) + 0.91) - 0.5;
      vec3 pixel_pos = cam.pixel00_loc.xyz
          + (float(thread.x) + jx) * cam.pixel_delta_u.xyz
          + (float(thread.y) + jy) * cam.pixel_delta_v.xyz;

      vec3 ray_origin = cam.center.xyz;
      vec3 ray_dir = normalize(pixel_pos - ray_origin);

      vec3 throughput = vec3(1.0, 1.0, 1.0);
      vec3 sample_energy = vec3(0.0, 0.0, 0.0);

      for (int i = 0; i < MAX_BOUNCES; i++) {
        hit_record rec;
        rec.t = 1e30;

        for (int j = 0; j < scene.triangles.length(); j++) {
          hit_record temp_rec;
          if (intersect_triangle(ray_origin, ray_dir, rec.t,
              scene.triangles[j], temp_rec)) {
            rec = temp_rec;
          }
        }

        // Break if no hit
        if (rec.t >= 1e30) {
          sample_energy += throughput * background_color;
          break;
        }

        // Light
        //sample_energy += 0.5 * throughput * BRDF * max(dot(rec.normal, light_dir), 0.0);
        // Continue bounces
        ray_origin = rec.p;
        float r0 = noise3D(seed, float(i) * 0.1273, rec.p.x);
        float r1 = noise3D(seed, float(i) * 0.3183, rec.p.y);
        float r2 = noise3D(seed, float(i) * 0.7123, rec.p.z);
        vec3 rand_unit_vec = normalize(vec3(r0, r1, r2) * 2.0 - 1.0);
        ray_dir = normalize(rec.normal + rand_unit_vec);
        throughput *= BRDF; //(max(dot(rec.normal, ray_dir), 0.0) / hemiPDF) * BRDF;
        // Removed hemisphere pdf cause its not in the CPU tracer, that way images are consistent this can be changed later
      }

      energy += sample_energy / float(SAMPLES);
    }
    energy = max(energy, vec3(0.0));
    imageStore(img, thread, vec4(energy, 1.0));
  }
}
