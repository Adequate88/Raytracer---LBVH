#version 460
#extension GL_GOOGLE_include_directive : require
#include "bvh_include.glsl"

void main() {
  uint idx = gl_GlobalInvocationID.x;
  if (idx >= primitiveCount) return;

  // Init node
  uint leaf_idx = primitiveCount - 1 + idx;

  parents[leaf_idx] = -1;
  leftChilds[leaf_idx] = -1;
  rightChilds[leaf_idx] = -1;
  atomicCounters[leaf_idx] = 0;
}
