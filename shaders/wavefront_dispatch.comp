#version 460

layout(local_size_x = 1) in;

layout(binding = 0, std430) readonly buffer NextRayCountBuffer {
  uint count;
} next_ray_count;

layout(binding = 1, std430) writeonly buffer DispatchSizeBuffer {
  uint x;
  uint y;
  uint z;
} dispatch_size;

void main() {
  dispatch_size.x = (next_ray_count.count + 255) / 256;
  dispatch_size.y = 1;
  dispatch_size.z = 1;
}